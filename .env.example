# Nhost Project Configuration
# Replace [subdomain] and [region] with your Nhost project details
NHOST_BACKEND_URL=https://[subdomain].nhost.run
NHOST_GRAPHQL_URL=https://[subdomain].graphql.[region].nhost.run/v1/graphql
NHOST_ADMIN_SECRET=your-nhost-admin-secret-here

# AI Engine Credentials
# If empty, execution will fallback to classification stubbing
GEMINI_API_KEY=your-gemini-api-key-here

# Local Development Settings
FUNCTIONS_PORT=5001
